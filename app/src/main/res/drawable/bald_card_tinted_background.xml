<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted variant of bald_card_background (accent blocks like the dialer row). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="?bald_brand_tint" />
            <stroke
                android:width="@dimen/border_width_selected"
                android:color="?bald_brand" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="?bald_button_clicked" />
            <stroke
                android:width="@dimen/border_width"
                android:color="?bald_card_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="?bald_brand_tint" />
            <stroke
                android:width="@dimen/border_width"
                android:color="?bald_card_border" />
        </shape>
    </item>
</selector>
