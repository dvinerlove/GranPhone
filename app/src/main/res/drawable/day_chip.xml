<?xml version="1.0" encoding="utf-8"?>
<!-- Capsule toggle for day-of-week chips and quick presets.
     checked = brand fill, pressed = clicked tint, default = card fill + border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/bald_brand" />
            <stroke
                android:width="@dimen/border_width_selected"
                android:color="?attr/bald_decoration_on_background" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/bald_card" />
            <stroke
                android:width="@dimen/border_width_selected"
                android:color="?attr/bald_decoration_on_background" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/bald_brand" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/bald_button_clicked" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/bald_card" />
            <stroke
                android:width="@dimen/border_width"
                android:color="?attr/bald_card_border" />
        </shape>
    </item>
</selector>
