<!-- Notification card: app icon + name + time header, title, text, worded clear button.
     Grouped rows keep the same ids; the adapter hides fields for summary rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:background="@drawable/bald_card_background"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
        android:importantForAccessibility="no"
            android:id="@+id/small_icon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md" />

        <TextView
            android:id="@+id/app_name"
            android:importantForAccessibility="no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?bald_text_secondary"
            android:textSize="@dimen/small" />

        <TextView
            android:id="@+id/time_stamp"
            android:importantForAccessibility="no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:textColor="?bald_text_secondary"
            android:textSize="@dimen/small" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />
        </LinearLayout>

        <ImageView
            android:id="@+id/large_icon"
            android:importantForAccessibility="no"
            android:layout_width="@dimen/icon_xl"
            android:layout_height="@dimen/icon_xl"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <com.bald.uriah.baldphone.views.BaldPictureTextButton
        android:id="@+id/clear"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height_default"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bald_button_background"
        app:_src="@drawable/delete_on_button"
        app:_text="@string/clear" />
</LinearLayout>
