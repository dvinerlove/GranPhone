<?xml version="1.0" encoding="utf-8"?><!--
  -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_1"
        app:title="@string/sos"
        app:show_back="true" />

    <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
        android:id="@+id/ec1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/style_for_buttons_pill"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:src="@drawable/add_on_button" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.5"
            android:gravity="start|center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/add_emergency_contact"
            android:textColor="?bald_text_on_background"
            android:textSize="@dimen/large" />

    </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>

    <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
        android:id="@+id/ec2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/style_for_buttons_pill"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:src="@drawable/add_on_button" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.5"
            android:gravity="start|center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/add_emergency_contact_2"
            android:textColor="?bald_text_on_background"
            android:textSize="@dimen/large" />
    </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>

    <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
        android:id="@+id/ec_real"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/call_button_red"
        android:backgroundTint="?attr/bald_danger"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:src="@drawable/emergency"
            android:tint="?attr/bald_text_on_variant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.5"
            android:gravity="start|center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/emergency_services"
            android:textColor="?attr/bald_text_on_variant"
            android:textSize="@dimen/large"
            android:textStyle="bold" />
    </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>
</LinearLayout>
