<?xml version="1.0" encoding="utf-8"?><!--
  -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?bald_brand"
        app:title="@string/sos"
        app:show_back="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xs"
        android:text="@string/sos_hold_explanation"
        android:textColor="?bald_text_secondary"
        android:textSize="@dimen/medium" />

    <!-- hold-to-confirm SOS button; tinted bald_danger in code -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md">

        <LinearLayout
            android:id="@+id/bt_sos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height_large"
            android:background="@drawable/bald_button_background"
            android:clickable="true"
            android:contentDescription="@string/sos_button_description"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- plain ImageView: tint must reach every path of the vector -->
            <ImageView
                android:layout_width="@dimen/avatar_sm"
                android:layout_height="@dimen/avatar_sm"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:importantForAccessibility="no"
                android:src="@drawable/emergency"
                android:tint="?attr/bald_text_on_variant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/sos"
                    android:textColor="?attr/bald_text_on_variant"
                    android:textSize="@dimen/giant"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sos_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/sos_call_help"
                    android:textColor="?attr/bald_text_on_variant"
                    android:textSize="@dimen/large" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/sos_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_sm"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:indeterminate="false"
            android:max="5000"
            android:progressTint="?attr/bald_text_on_variant"
            android:progressBackgroundTint="?attr/bald_danger"
            android:visibility="gone" />
    </FrameLayout>

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/sos_scroll_view"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/ec1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:background="@drawable/bald_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_lg">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- SquaredCircleImageView renders at half its layout size: 128dp -> 64dp -->
                        <com.bald.uriah.baldphone.views.SquaredCircleImageView
                            android:id="@+id/ec1_avatar"
                            android:layout_width="128dp"
                            android:layout_height="128dp" />

                        <TextView
                            android:id="@+id/ec1_letter"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:gravity="center"
                            android:textColor="?bald_text_on_background"
                            android:textSize="@dimen/large"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/ec1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?bald_text_primary"
                        android:textSize="@dimen/large"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_call_white"
                        android:tint="?attr/bald_brand_strong" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ec2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bald_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_lg">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- SquaredCircleImageView renders at half its layout size: 128dp -> 64dp -->
                        <com.bald.uriah.baldphone.views.SquaredCircleImageView
                            android:id="@+id/ec2_avatar"
                            android:layout_width="128dp"
                            android:layout_height="128dp" />

                        <TextView
                            android:id="@+id/ec2_letter"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:gravity="center"
                            android:textColor="?bald_text_on_background"
                            android:textSize="@dimen/large"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/ec2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?bald_text_primary"
                        android:textSize="@dimen/large"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_call_white"
                        android:tint="?attr/bald_brand_strong" />
                </LinearLayout>

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_add_contact"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bald_button_background"
                    app:_size="@dimen/medium"
                    app:_src="@drawable/add_on_button"
                    app:_text="@string/add_emergency_contact" />
            </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>
</LinearLayout>
