<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs"
    android:orientation="vertical"
    android:visibility="visible">

    <ImageView
        android:id="@+id/iv"
        android:layout_width="@dimen/icon_xl"
        android:layout_height="@dimen/icon_xl"
        android:importantForAccessibility="no"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:layout_constraintBottom_toTopOf="@+id/tv"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv"
        android:textSize="@dimen/small"
        style="@style/BackgroundText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv" />

    <Space
        android:id="@+id/space"
        android:layout_width="@dimen/divider"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:layout_constraintBottom_toTopOf="@id/iv"
        app:layout_constraintStart_toEndOf="@id/iv" />

    <View
        android:id="@+id/notifications_counter"
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:background="@drawable/notifications_pill"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@id/space"
        app:layout_constraintTop_toBottomOf="@id/space" />
</androidx.constraintlayout.widget.ConstraintLayout>