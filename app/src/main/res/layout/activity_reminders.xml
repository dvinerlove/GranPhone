<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_1"
        app:show_back="true"
        app:title="@string/pills" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:id="@+id/scrolling_helper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:empty_text="@string/no_pills"
        app:horizontal_scrolling="false">

        <!-- ModularRecyclerView must stay the first child (ScrollingHelper contract);
             empty_view is picked up by id and shown when the adapter is empty. -->
        <com.bald.uriah.baldphone.views.ModularRecyclerView
            android:id="@+id/recycler_view"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="invisible">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:src="@drawable/pill" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/no_pills"
                android:textColor="?attr/bald_text_secondary"
                android:textSize="20sp" />
        </LinearLayout>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_add"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1.3"
            android:background="@drawable/style_for_buttons"
            app:_size="@dimen/medium"
            app:_src="@drawable/add_on_button"
            app:_text="@string/pill"
            app:variant="brand" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_time_changer"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:_size="@dimen/medium"
            app:_src="@drawable/time_on_background"
            app:_text="@string/pill_time" />
    </LinearLayout>
</LinearLayout>
