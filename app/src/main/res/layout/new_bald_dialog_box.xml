<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:background="@drawable/bald_dialog_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingBottom="@dimen/dialog_actions_reserve">
        <TextView
            android:id="@+id/dialog_box_title"
            style="@style/BackgroundText.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center"
            android:maxLines="3"
            android:paddingStart="@dimen/dialog_action_inset"
            android:paddingEnd="@dimen/dialog_action_inset" />
        <ScrollView
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/dialog_box_text"
                    style="@style/BackgroundText.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:singleLine="false"
                    android:textColor="?bald_text_secondary" />
                <EditText
                    android:id="@+id/edit_text"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bald_button_background"
                    android:imeOptions="actionGo"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:textColor="?bald_text_on_background"
                    android:textColorHint="?bald_hint_on_background"
                    android:visibility="gone" />
                <FrameLayout
                    android:id="@+id/frame_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_md" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="@dimen/dialog_action_inset"
        android:layout_marginEnd="@dimen/dialog_action_inset"
        android:layout_marginBottom="@dimen/dialog_action_inset"
        android:orientation="horizontal">
        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_box_true"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:text="@string/yes"
            app:autoSizeMaxTextSize="@dimen/large"
            app:autoSizeMinTextSize="@dimen/small"
            app:autoSizeTextType="uniform" />
        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_box_false"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:text="@string/no"
            app:autoSizeMaxTextSize="@dimen/large"
            app:autoSizeMinTextSize="@dimen/small"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
</FrameLayout>
