<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <include
        android:id="@+id/top_bar"
        layout="@layout/home_screen_top_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintDimensionRatio="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <com.bald.uriah.baldphone.views.home.HomePage1
            android:id="@+id/home_page_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/home_bottom_bar_height"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_home_sos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/home_bottom_bar_height"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:_src="@drawable/emergency_on_button"
            app:_text="@string/sos"
            app:variant="danger" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_home_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/home_bottom_bar_height"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:_src="@drawable/apps_on_background"
            app:_text="@string/apps" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_home_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/home_bottom_bar_height"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:_src="@drawable/settings_on_button"
            app:_text="@string/settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
