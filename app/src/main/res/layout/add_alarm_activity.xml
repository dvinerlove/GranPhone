<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?bald_brand"
        app:show_back="true"
        app:title="@string/add_alarm" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/child"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:labelFor="@id/alarm_edit_name"
                android:text="@string/alarm_name"
                android:textColor="?attr/bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/alarm_edit_name"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_default"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_button_background"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="?attr/bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/time"
                android:textColor="?attr/bald_text_primary"
                android:textSize="@dimen/small" />

            <include
                layout="@layout/hour_and_minute_choosers"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/repeat"
                android:textColor="?attr/bald_text_primary"
                android:textSize="@dimen/small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_card_background"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_md">

                <RadioButton
                    android:id="@+id/rb_once"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:background="@drawable/bald_ghost_button_background"
                    android:button="@null"
                    android:drawableStart="@drawable/radio_circle"
                    android:drawablePadding="@dimen/spacing_lg"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/only_once"
                    android:textColor="?attr/bald_text_primary"
                    android:textSize="@dimen/medium" />

                <RadioButton
                    android:id="@+id/rb_every_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:background="@drawable/bald_ghost_button_background"
                    android:button="@null"
                    android:drawableStart="@drawable/radio_circle"
                    android:drawablePadding="@dimen/spacing_lg"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/repeats_every_day"
                    android:textColor="?attr/bald_text_primary"
                    android:textSize="@dimen/medium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="?attr/bald_card_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="@string/specific_days"
                    android:textColor="?attr/bald_text_secondary"
                    android:textSize="@dimen/small" />

                <include layout="@layout/day_chips" />
            </LinearLayout>
        </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_cancel"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/tiny"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/bald_button_background"
            android:text="@string/cancel" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_alarm_submit"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/tiny"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/call_button_green"
            android:backgroundTint="?attr/bald_brand"
            android:text="@string/save"
            android:textColor="?attr/bald_text_on_brand"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
