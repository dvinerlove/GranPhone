<!-- Alarm ringing screen: clock hero + alarm name, then two worded 88dp actions —
     snooze (neutral) and dismiss (danger). No icons-without-labels, no corner X. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bald_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <TextClock
        android:id="@+id/textClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autoSizeMinTextSize="48sp"
        android:autoSizeTextType="uniform"
        android:textColor="?attr/bald_text_primary"
        android:textSize="96sp"
        tools:ignore="SpUsage" />

    <TextView
        android:id="@+id/alarm_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="?attr/bald_text_secondary"
        android:textSize="@dimen/huge"
        tools:text="Вставать" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.bald.uriah.baldphone.views.BaldPictureTextButton
        android:id="@+id/snooze"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:background="@drawable/bald_button_background"
        app:_size="@dimen/large"
        app:_src="@drawable/clock_on_background"
        app:_text="@string/snooze" />

    <com.bald.uriah.baldphone.views.BaldPictureTextButton
        android:id="@+id/alarm_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@drawable/bald_button_background"
        app:_size="@dimen/large"
        app:_src="@drawable/alarm_off_on_button"
        app:_text="@string/turn_off"
        app:variant="danger" />

</LinearLayout>
