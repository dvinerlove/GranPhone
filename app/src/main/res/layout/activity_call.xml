<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen call screen (incoming and ongoing calls) with very large buttons.
  Shown by BaldInCallService when GranPhone is the default phone app.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_sm">

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/child"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/title_bar_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="@dimen/spacing_md">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tv_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textColor="?bald_background"
                            android:textSize="@dimen/giant"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="?bald_text_primary"
                            android:textSize="@dimen/giant"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="?bald_text_primary"
                            android:textSize="@dimen/large" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textColor="?bald_text_primary"
                    android:textSize="@dimen/huge" />
            </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:id="@+id/incoming_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- heights 120/96/88dp are the deliberate critical-call exception (DESIGN.md) -->
        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_answer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bald_button_background"
            app:_size="@dimen/giant"
            app:_src="@drawable/ic_call_white"
            app:_text="@string/answer_call"
            app:variant="brand" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_decline"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bald_button_background"
            app:_size="@dimen/huge"
            app:_src="@drawable/ic_call_end_white"
            app:_text="@string/decline_call"
            app:variant="danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ongoing_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_speaker"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/bald_button_background"
            app:_size="@dimen/huge"
            app:_src="@drawable/ic_volume_up"
            app:_text="@string/speaker_turn_on" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_hangup"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bald_button_background"
            app:_size="@dimen/giant"
            app:_src="@drawable/ic_call_end_white"
            app:_text="@string/hang_up"
            app:variant="danger" />
    </LinearLayout>

</LinearLayout>
