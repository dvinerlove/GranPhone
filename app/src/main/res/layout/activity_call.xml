<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen call screen (incoming and ongoing calls) with very large buttons.
  Shown by BaldInCallService when GranPhone is the default phone app.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginEnd="12dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="?bald_background"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="?bald_text_on_background"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="?bald_text_on_background"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?bald_text_on_background"
        android:textSize="30sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/incoming_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/bt_answer"
            style="@style/CallButton"
            android:layout_height="120dp"
            android:background="@drawable/call_button_green"
            android:drawableStart="@drawable/ic_call_white"
            android:maxLines="1"
            android:text="@string/answer_call"
            app:autoSizeTextType="uniform" />

        <Button
            android:id="@+id/bt_decline"
            style="@style/CallButton"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/call_button_red"
            android:drawableStart="@drawable/ic_call_end_white"
            android:maxLines="1"
            android:text="@string/decline_call"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ongoing_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/bt_speaker"
            style="@style/CallButton"
            android:layout_height="88dp"
            android:background="@drawable/call_button_gray"
            android:drawableStart="@drawable/ic_volume_up_white"
            android:maxLines="1"
            android:text="@string/speaker_turn_on"
            android:textSize="30sp"
            app:autoSizeTextType="uniform" />

        <Button
            android:id="@+id/bt_hangup"
            style="@style/CallButton"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/call_button_red"
            android:drawableStart="@drawable/ic_call_end_white"
            android:maxLines="1"
            android:text="@string/hang_up"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

</LinearLayout>
