<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md"
    android:weightSum="5.2"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_1"
            style="@style/DialerKey"
            android:text="1" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_2"
            style="@style/DialerKey"
            android:text="2" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_3"
            style="@style/DialerKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_4"
            style="@style/DialerKey"
            android:text="4" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_5"
            style="@style/DialerKey"
            android:text="5" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_6"
            style="@style/DialerKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_7"
            style="@style/DialerKey"
            android:text="7" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_8"
            style="@style/DialerKey"
            android:text="8" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_9"
            style="@style/DialerKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_sulamit"
            style="@style/DialerKey"
            android:text="*" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_0"
            style="@style/DialerKey"
            android:text="0" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_hash"
            style="@style/DialerKey"
            android:text="#" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/b_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:contentDescription="@string/clear"
            android:orientation="vertical"
            app:_src="@drawable/delete_on_button"
            app:_text="@string/clear" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/b_call"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1.4"
            android:background="@drawable/bald_button_background"
            android:contentDescription="@string/call"
            android:orientation="vertical"
            app:_src="@drawable/phone_on_button"
            app:_text="@string/call"
            app:variant="brand" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/b_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:contentDescription="@string/backspace"
            android:orientation="vertical"
            app:_src="@drawable/backspace_on_button"
            app:_text="@string/delete"
            app:variant="danger" />
    </LinearLayout>

</LinearLayout>
