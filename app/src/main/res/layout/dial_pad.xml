<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:weightSum="5.2"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_1"
            style="@style/DialerKey"
            android:text="1" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_2"
            style="@style/DialerKey"
            android:text="2" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_3"
            style="@style/DialerKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_4"
            style="@style/DialerKey"
            android:text="4" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_5"
            style="@style/DialerKey"
            android:text="5" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_6"
            style="@style/DialerKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_7"
            style="@style/DialerKey"
            android:text="7" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_8"
            style="@style/DialerKey"
            android:text="8" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_9"
            style="@style/DialerKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_sulamit"
            style="@style/DialerKey"
            android:text="*" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_0"
            style="@style/DialerKey"
            android:text="0" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_hash"
            style="@style/DialerKey"
            android:text="#" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
            android:id="@+id/b_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            android:contentDescription="@string/clear"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/delete_on_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/clear"
                android:textColor="?bald_text_on_button"
                app:autoSizeMaxTextSize="@dimen/medium"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>

        <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
            android:id="@+id/b_call"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1.4"
            android:background="@drawable/style_for_buttons_green"
            android:contentDescription="@string/call"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/phone_on_button"
                android:tint="?bald_text_on_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/call"
                android:textColor="?bald_text_on_variant"
                app:autoSizeMaxTextSize="@dimen/medium"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>

        <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
            android:id="@+id/b_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            android:contentDescription="@string/backspace"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/backspace_on_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/delete"
                android:textColor="?bald_text_on_button"
                app:autoSizeMaxTextSize="@dimen/medium"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>
    </LinearLayout>

</LinearLayout>
