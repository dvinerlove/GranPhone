<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/dialog_screen_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/large" />

    <com.bald.uriah.baldphone.views.MaxHeightScrollView
        android:id="@+id/dialog_screen_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_screen_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?bald_text_secondary"
                android:textSize="@dimen/medium" />

            <LinearLayout
                android:id="@+id/dialog_screen_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.bald.uriah.baldphone.views.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_screen_button_secondary"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_screen_button_primary"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
</LinearLayout>
