<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xl"
    android:background="@drawable/bald_dialog_background"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <TextView
        android:id="@+id/dialog_screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/large" />

    <com.bald.uriah.baldphone.views.MaxHeightScrollView
        android:id="@+id/dialog_screen_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_screen_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?bald_text_secondary"
                android:textSize="@dimen/medium" />

            <LinearLayout
                android:id="@+id/dialog_screen_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.bald.uriah.baldphone.views.MaxHeightScrollView>

    <!-- interactive payloads stay pinned below the scroll — they are the point
         of the dialog and must never scroll out of reach -->
    <FrameLayout
        android:id="@+id/dialog_screen_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_screen_button_secondary"
            style="@style/ButtonsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:minHeight="@dimen/dialog_button_height"
            android:maxLines="2" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/dialog_screen_button_primary"
            style="@style/ButtonsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            android:minHeight="@dimen/dialog_button_height"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
