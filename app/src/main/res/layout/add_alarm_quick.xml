<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?bald_brand"
        app:show_back="true"
        app:title="@string/add_alarm_quickly" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/child"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_time"
                android:textColor="?attr/bald_text_secondary"
                android:textSize="@dimen/small" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/bald_text_primary"
                android:textSize="@dimen/giant" />

            <TextView
                android:id="@+id/alarm_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/invoked_in"
                android:textColor="?attr/bald_text_secondary"
                android:textSize="@dimen/small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/bt_dec"
                android:focusable="true"
                    android:layout_width="@dimen/button_height_large"
                    android:layout_height="@dimen/button_height_large"
                    android:background="@drawable/bald_button_background"
                    android:contentDescription="@string/less"
                    android:padding="@dimen/spacing_lg"
                    android:src="@drawable/remove_on_button" />

                <TextView
                    android:id="@+id/tv_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/bald_text_primary"
                    android:textSize="@dimen/giant"
                    android:textStyle="bold" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/bt_add"
                android:focusable="true"
                    android:layout_width="@dimen/button_height_large"
                    android:layout_height="@dimen/button_height_large"
                    android:background="@drawable/bald_button_background"
                    android:contentDescription="@string/more"
                    android:padding="@dimen/spacing_lg"
                    android:src="@drawable/add_on_button" />
            </LinearLayout>

            <!-- quick presets; labels are set in code ("1 мин" …) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.bald.uriah.baldphone.views.BaldButton
                    android:id="@+id/preset_1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/day_chip"
                    android:gravity="center"
                    android:textColor="@color/day_chip_text"
                    android:textSize="@dimen/small" />

                <com.bald.uriah.baldphone.views.BaldButton
                    android:id="@+id/preset_5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/day_chip"
                    android:gravity="center"
                    android:textColor="@color/day_chip_text"
                    android:textSize="@dimen/small" />

                <com.bald.uriah.baldphone.views.BaldButton
                    android:id="@+id/preset_10"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/day_chip"
                    android:gravity="center"
                    android:textColor="@color/day_chip_text"
                    android:textSize="@dimen/small" />
            </LinearLayout>
        </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_cancel"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/tiny"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/bald_button_background"
            android:text="@string/cancel" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_alarm_submit"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/tiny"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/call_button_green"
            android:backgroundTint="?attr/bald_brand"
            android:text="@string/save"
            android:textColor="?attr/bald_text_on_brand"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
