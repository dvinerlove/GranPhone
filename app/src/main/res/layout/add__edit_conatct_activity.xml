<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?bald_brand"
        app:show_back="true"
        app:title="@string/add_contact" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/child"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:labelFor="@id/et_name"
                android:text="@string/name"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.bald.uriah.baldphone.views.BaldEditText
                    android:id="@+id/et_name"
                    style="@style/BackgroundText.Large"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:nextFocusForward="@+id/et_mobile_number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColorHint="?bald_hint_on_background" />

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp">

                    <com.bald.uriah.baldphone.views.BaldImageButton
                        android:id="@+id/iv_image"
                android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/style_for_buttons"
                        android:contentDescription="@string/photo"
                        android:padding="16dp"
                        android:src="@drawable/photo_on_button" />

                    <com.bald.uriah.baldphone.views.BaldImageButton
                        android:id="@+id/iv_delete"
                android:focusable="true"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/call_button_red"
                        android:contentDescription="@string/delete"
                        android:padding="8dp"
                        android:src="@drawable/delete_on_button"
                        android:visibility="invisible" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_name_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="@string/contact_must_has_name"
                android:textColor="?bald_danger"
                android:textSize="@dimen/small"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:labelFor="@id/et_mobile_number"
                android:text="@string/mobile_phone_number"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_mobile_number"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/style_for_buttons"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_home_number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:labelFor="@id/et_home_number"
                android:text="@string/home_phone_number"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_home_number"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/style_for_buttons"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_address"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:labelFor="@id/et_address"
                android:text="@string/address"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_address"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/style_for_buttons"
                android:imeOptions="actionNext"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_mail"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:labelFor="@id/et_mail"
                android:text="@string/mail"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_mail"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/style_for_buttons"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="?bald_hint_on_background" />
        </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/cancel"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/style_for_buttons"
            android:text="@string/cancel" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/save"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/call_button_green"
            android:backgroundTint="?attr/bald_brand"
            android:text="@string/save"
            android:textColor="?attr/bald_text_on_variant"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
