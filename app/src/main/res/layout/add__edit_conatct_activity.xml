<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?bald_brand"
        app:show_back="true"
        app:title="@string/add_contact" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/child"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:labelFor="@id/et_name"
                android:text="@string/name"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.bald.uriah.baldphone.views.BaldEditText
                    android:id="@+id/et_name"
                    style="@style/BackgroundText.Large"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:background="@drawable/bald_button_background"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:nextFocusForward="@+id/et_mobile_number"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:textColorHint="?bald_hint_on_background" />

                <FrameLayout
                    android:layout_width="@dimen/avatar_lg"
                    android:layout_height="@dimen/avatar_lg">

                    <com.bald.uriah.baldphone.views.BaldImageButton
                        android:id="@+id/iv_image"
                android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bald_button_background"
                        android:contentDescription="@string/photo"
                        android:padding="@dimen/spacing_lg"
                        android:src="@drawable/photo_on_button" />

                    <com.bald.uriah.baldphone.views.BaldImageButton
                        android:id="@+id/iv_delete"
                android:focusable="true"
                        android:layout_width="@dimen/avatar_md"
                        android:layout_height="@dimen/avatar_md"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/delete_badge_background"
                        android:contentDescription="@string/delete"
                        android:padding="@dimen/spacing_sm"
                        android:src="@drawable/delete_on_button"
                        android:visibility="invisible" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_name_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/contact_must_has_name"
                android:textColor="?bald_danger"
                android:textSize="@dimen/small"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:labelFor="@id/et_mobile_number"
                android:text="@string/mobile_phone_number"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_mobile_number"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_button_background"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_home_number"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:labelFor="@id/et_home_number"
                android:text="@string/home_phone_number"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_home_number"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_button_background"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_address"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:labelFor="@id/et_address"
                android:text="@string/address"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_address"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_button_background"
                android:imeOptions="actionNext"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:nextFocusForward="@+id/et_mail"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="?bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:labelFor="@id/et_mail"
                android:text="@string/mail"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/small" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/et_mail"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bald_button_background"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="?bald_hint_on_background" />
        </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/cancel"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="@dimen/list_row_height_tall"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/tiny"
            app:autoSizeMaxTextSize="@dimen/large"
            android:background="@drawable/bald_button_background"
            android:text="@string/cancel" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/save"
            android:layout_width="0dp"
            android:layout_height="@dimen/list_row_height_tall"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bald_button_background"
            app:_size="@dimen/large"
            app:_text="@string/save"
            app:variant="brand" />
    </LinearLayout>
</LinearLayout>
