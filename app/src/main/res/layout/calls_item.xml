<!-- Call-log row card — contacts-list look: optional day header, avatar,
     name, call-type icon + worded label (missed = danger), time.
     Card separation replaces the divider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contact_row_linear_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height_tall"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldButton
        android:id="@+id/day"
        style="@style/BackgroundText.Medium"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_header_height"
        android:background="@android:color/transparent"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:textColor="?bald_text_secondary"
        android:textSize="@dimen/large"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- kept for the adapter's id contract; card gaps are the divider -->
    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <com.bald.uriah.baldphone.views.BaldLinearLayoutButton
        android:id="@+id/ll_contact_only"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_row_height_tall"
        android:background="@drawable/bald_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/pic_holder"
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:layout_marginStart="@dimen/spacing_lg">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:transitionName="prof_pic_contacts_animation" />

            <TextView
                android:id="@+id/image_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/large"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?bald_text_primary"
                android:textSize="@dimen/large"
                android:transitionName="bald_bar_title_animation"
                app:autoSizeMinTextSize="@dimen/tiny"
                app:autoSizeTextType="uniform" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_call_type"
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_call_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:textSize="@dimen/small" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:textColor="?bald_text_secondary"
            android:textSize="@dimen/small" />
    </com.bald.uriah.baldphone.views.BaldLinearLayoutButton>

</LinearLayout>
