<?xml version="1.0" encoding="utf-8"?>
<!-- Alarm-volume stepper for DialogBuilder extraView: big [- % +] controls,
     replaces the thin SeekBar. Value 0..VOLUME_MAX, shown as percent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <com.bald.uriah.baldphone.views.BaldButton
        android:id="@+id/bt_volume_down"
        android:layout_width="@dimen/avatar_lg"
        android:layout_height="@dimen/button_height_default"
        android:background="@drawable/bald_button_background"
        android:text="@string/volume_down"
        android:textSize="@dimen/giant" />

    <TextView
        android:id="@+id/tv_volume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/giant"
        tools:text="80%" />

    <com.bald.uriah.baldphone.views.BaldButton
        android:id="@+id/bt_volume_up"
        android:layout_width="@dimen/avatar_lg"
        android:layout_height="@dimen/button_height_default"
        android:background="@drawable/bald_button_background"
        android:text="@string/volume_up"
        android:textSize="@dimen/giant" />
</LinearLayout>
