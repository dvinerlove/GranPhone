<!-- Shared empty state. <include android:id="@+id/empty_view"> inside a ScrollingHelper,
     after the ModularRecyclerView (which must stay the first child).
     ScrollingHelper fills empty_icon / empty_text from its app:empty_icon / app:empty_text
     attrs and toggles visibility from the adapter count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="invisible">

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:alpha="0.5"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="?attr/bald_text_secondary"
        android:textSize="@dimen/medium" />
</LinearLayout>
