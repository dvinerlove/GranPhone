<!-- Alarm row card: bald_card fill + 16dp corners + 1dp border (dialog_screen_card).
     Big time + Вкл/Выкл state switch on top, name + repeat summary secondary,
     worded edit/delete actions at the bottom end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/dialog_screen_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/bald_text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- weight-fill whatever the time label leaves over: the switch must
             never overflow the card edge -->
        <com.bald.uriah.baldphone.views.BaldSwitch
            android:id="@+id/alarm_switch"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            app:no="@string/off_short"
            app:size="@dimen/medium"
            app:yes="@string/on_short" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/bald_text_primary"
        android:textSize="@dimen/medium" />

    <TextView
        android:id="@+id/repeating_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/bald_text_secondary"
        android:textSize="@dimen/small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_edit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/style_for_buttons"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:_size="@dimen/medium"
            app:_src="@drawable/edit_on_button"
            app:_text="@string/edit" />

        <com.bald.uriah.baldphone.views.BaldPictureTextButton
            android:id="@+id/bt_delete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/style_for_buttons"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:_size="@dimen/medium"
            app:_src="@drawable/delete_on_button"
            app:_text="@string/delete" />
    </LinearLayout>
</LinearLayout>
