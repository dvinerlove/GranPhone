<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/button_height_default"
    android:background="@drawable/bald_ghost_button_background"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/dialog_screen_option_check"
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:importantForAccessibility="no"
        android:src="@drawable/check_on_button"
        android:tint="?bald_brand"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/dialog_screen_option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_weight="1"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/medium" />
</LinearLayout>
