<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/style_for_buttons_transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/dialog_screen_option_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/check_on_button"
        android:tint="?bald_brand"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/dialog_screen_option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textColor="?bald_text_primary"
        android:textSize="20sp" />
</LinearLayout>
