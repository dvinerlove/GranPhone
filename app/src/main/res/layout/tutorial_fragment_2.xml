<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bald"
        style="@style/BackgroundText.Auto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/spacing_lg"
        android:text="@string/first_please_select_how_you_want_to_interact_with_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bald">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.bald.uriah.baldphone.views.BaldFrameLayoutButton
                android:id="@+id/long_presses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/bald_card_background"
                android:minHeight="96dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/high_level"
                            android:textColor="?bald_text_primary"
                            android:textSize="@dimen/large" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:maxLines="2"
                            android:text="@string/accessibility_level_high_desc"
                            android:textColor="?bald_text_secondary"
                            android:textSize="@dimen/small" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/long_presses_selected"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_on_button"
                        android:tint="?bald_brand"
                        android:visibility="invisible" />
                </LinearLayout>
            </com.bald.uriah.baldphone.views.BaldFrameLayoutButton>

            <com.bald.uriah.baldphone.views.BaldFrameLayoutButton
                android:id="@+id/medium_presses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/bald_card_background"
                android:minHeight="96dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/medium_level"
                            android:textColor="?bald_text_primary"
                            android:textSize="@dimen/large" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:maxLines="2"
                            android:text="@string/accessibility_level_medium_desc"
                            android:textColor="?bald_text_secondary"
                            android:textSize="@dimen/small" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/medium_presses_selected"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_on_button"
                        android:tint="?bald_brand"
                        android:visibility="invisible" />
                </LinearLayout>
            </com.bald.uriah.baldphone.views.BaldFrameLayoutButton>

            <com.bald.uriah.baldphone.views.BaldFrameLayoutButton
                android:id="@+id/short_presses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/bald_card_background"
                android:minHeight="96dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/regular_level"
                            android:textColor="?bald_text_primary"
                            android:textSize="@dimen/large" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:maxLines="2"
                            android:text="@string/accessibility_level_regular_desc"
                            android:textColor="?bald_text_secondary"
                            android:textSize="@dimen/small" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/short_presses_selected"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_on_button"
                        android:tint="?bald_brand"
                        android:visibility="invisible" />
                </LinearLayout>
            </com.bald.uriah.baldphone.views.BaldFrameLayoutButton>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
