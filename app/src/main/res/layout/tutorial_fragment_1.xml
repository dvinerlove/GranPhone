<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/hello"
        style="@style/BackgroundText.Huge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/hello"
        android:textSize="60sp" />

    <TextView
        android:id="@+id/and_welcome_to_granphone"
        style="@style/BackgroundText.Huge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:text="@string/and_welcome_to_GranPhone"
        android:textSize="@dimen/giant"
        app:autoSizeMaxTextSize="@dimen/giant"
        app:autoSizeMinTextSize="@dimen/tiny"
        app:autoSizeTextType="uniform"
        android:visibility="gone" />

    <com.bald.uriah.baldphone.views.BaldButton
        android:id="@+id/bt_next"
        style="@style/ButtonsText.Large"
        android:layout_width="220dp"
        android:layout_height="90dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="@dimen/spacing_xl"
        android:background="@drawable/bald_button_background"
        android:text="@string/next" />
</LinearLayout>