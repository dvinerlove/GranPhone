<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_1"
        app:show_back="true"
        app:title="" />

    <com.bald.uriah.baldphone.views.ScrollingHelper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bald.uriah.baldphone.views.ModularScrollView
            android:id="@+id/single_contact_scroll_view"
            style="@style/ScrollStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- SquaredCircleImageView renders at half its layout size: 192dp -> 96dp -->
                        <com.bald.uriah.baldphone.views.SquaredCircleImageView
                            android:id="@+id/contact_image"
                            android:layout_width="192dp"
                            android:layout_height="192dp"
                            android:transitionName="prof_pic_contacts_animation" />

                        <TextView
                            android:id="@+id/image_letter"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:gravity="center"
                            android:textColor="?bald_text_on_background"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/bt_favorite"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/style_for_buttons_transparent"
                        android:contentDescription="@string/add_to_favorite"
                        android:padding="8dp"
                        android:src="@drawable/star_on_button" />
                </LinearLayout>

                <!-- Full-width row so the name can only wrap at word boundaries -->
                <TextView
                    android:id="@+id/tv_contact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="2"
                    android:textColor="?bald_text_on_background"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_call"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/style_for_buttons_green"
                    app:_src="@drawable/ic_call_white"
                    app:_text="@string/call"
                    app:variant="brand" />

                <LinearLayout
                    android:id="@+id/ll_phones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_sms"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/style_for_buttons"
                    app:_src="@drawable/message_on_button"
                    app:_text="@string/message"
                    app:variant="info" />

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_edit"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/style_for_buttons"
                    app:_src="@drawable/edit_on_button"
                    app:_text="@string/edit" />

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_share"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/style_for_buttons"
                    app:_src="@drawable/share_on_button"
                    app:_text="@string/share" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dialog_screen_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_to_sos"
                        android:textColor="?bald_text_primary"
                        android:textSize="20sp" />

                    <com.bald.uriah.baldphone.views.BaldSwitch
                        android:id="@+id/sos_switch"
                        android:layout_width="180dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        app:no="@string/no"
                        app:size="@dimen/small"
                        app:yes="@string/yes" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dialog_screen_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pin_to_home"
                        android:textColor="?bald_text_primary"
                        android:textSize="20sp" />

                    <com.bald.uriah.baldphone.views.BaldSwitch
                        android:id="@+id/home_pin_switch"
                        android:layout_width="180dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        app:no="@string/no"
                        app:size="@dimen/small"
                        app:yes="@string/yes" />
                </LinearLayout>

                <com.bald.uriah.baldphone.views.BaldPictureTextButton
                    android:id="@+id/bt_delete"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/style_for_buttons"
                    app:_src="@drawable/delete_on_button"
                    app:_text="@string/delete"
                    app:variant="danger" />

                <LinearLayout
                    android:id="@+id/ll_dynamic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.bald.uriah.baldphone.views.ModularScrollView>
    </com.bald.uriah.baldphone.views.ScrollingHelper>
</LinearLayout>
