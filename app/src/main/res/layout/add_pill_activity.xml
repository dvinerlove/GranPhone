<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bald_background"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_1"
        app:show_back="true"
        app:title="@string/add_pill" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/pill_name"
                android:textColor="?attr/bald_text_primary"
                android:textSize="18sp" />

            <com.bald.uriah.baldphone.views.BaldEditText
                android:id="@+id/reminder_edit_name"
                style="@style/BackgroundText.Large"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/style_for_buttons"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="?attr/bald_hint_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/time"
                android:textColor="?attr/bald_text_primary"
                android:textSize="18sp" />

            <com.bald.uriah.baldphone.views.BaldMultipleSelection
                android:id="@+id/multiple_selection"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                app:text_size="@dimen/medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/color"
                android:textColor="?attr/bald_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/blue"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_selected"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:tint="@color/blue" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/red"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:tint="@color/red" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/gray"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:tint="@color/gray" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/yellow"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:tint="@color/yellow" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/green"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:tint="@color/green" />

                <com.bald.uriah.baldphone.views.BaldImageButton
                    android:id="@+id/custom"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:padding="8dp"
                    android:src="@drawable/pill"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/repeat"
                android:textColor="?attr/bald_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/dialog_screen_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_every_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:background="@drawable/style_for_buttons_transparent"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/radio_circle"
                    android:drawablePadding="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/repeats_every_day"
                    android:textColor="?attr/bald_text_primary"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/bald_card_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/specific_days"
                    android:textColor="?attr/bald_text_secondary"
                    android:textSize="16sp" />

                <include layout="@layout/day_chips" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_cancel"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/style_for_buttons"
            android:text="@string/cancel" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/bt_submit"
            style="@style/ButtonsText.Large"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:background="@drawable/call_button_green"
            android:backgroundTint="?attr/bald_brand"
            android:text="@string/save"
            android:textColor="?attr/bald_text_on_variant"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
