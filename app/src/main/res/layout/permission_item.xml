<!-- One permission = one card: what it is, why it's needed, big "Allow". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bald_card_background"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/large"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textColor="?bald_text_secondary"
        android:textSize="@dimen/small" />

    <com.bald.uriah.baldphone.views.BaldPictureTextButton
        android:id="@+id/allow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@drawable/bald_button_background"
        app:_size="@dimen/large"
        app:_src="@drawable/check_on_button"
        app:_text="@string/allow"
        app:variant="brand" />

</LinearLayout>
