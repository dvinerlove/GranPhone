<!-- 56dp capsule day toggles: checked = brand fill + on-variant text,
     unchecked = card fill + border. Ids sunday..saturday are the contract. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/sunday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_sunday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/monday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_monday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/tuesday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_tuesday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/wednesday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_wednesday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/thursday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_thursday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/friday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_friday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/saturday"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/day_chip"
            android:button="@null"
            android:gravity="center"
            android:text="@string/choose_saturday"
            android:textColor="@color/day_chip_text"
            android:textSize="18sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_margin="4dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
