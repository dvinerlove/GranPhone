<?xml version="1.0" encoding="utf-8"?>
<!-- PIN pad for the pin_page screen (bound by PinPad): dot readout + 3x4 digit
     grid in the dialer's house style (dialer_key_background, huge digits). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/tv_pin_dots"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_default"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="?bald_text_primary"
        android:textSize="@dimen/huge"
        tools:text="●●○○" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_1"
            style="@style/DialerKey"
            android:text="1" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_2"
            style="@style/DialerKey"
            android:text="2" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_3"
            style="@style/DialerKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_4"
            style="@style/DialerKey"
            android:text="4" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_5"
            style="@style/DialerKey"
            android:text="5" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_6"
            style="@style/DialerKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:orientation="horizontal">

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_7"
            style="@style/DialerKey"
            android:text="7" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_8"
            style="@style/DialerKey"
            android:text="8" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_9"
            style="@style/DialerKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/spacing_sm"
            android:layout_weight="1" />

        <com.bald.uriah.baldphone.views.BaldButton
            android:id="@+id/b_0"
            style="@style/DialerKey"
            android:text="0" />

        <com.bald.uriah.baldphone.views.BaldImageButton
            android:id="@+id/b_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/dialer_key_background"
            android:contentDescription="@string/backspace"
            android:padding="@dimen/spacing_lg"
            android:src="@drawable/backspace_on_button" />
    </LinearLayout>
</LinearLayout>
